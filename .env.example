# Demo staff-desk key. The login card shows this value on purpose.
CEDAR_ADMIN_KEY=cedar-demo
# Signs the desk cookie. Change it if you deploy this anywhere shared.
CEDAR_ADMIN_SECRET=cedar-grove-demo-secret

# Optional. When either key is set, that model calls tools and writes grounded answers.
# Emergencies, medical refusals, and prompt-injection attempts stay on the local guardrails.
# With no keys, the deterministic demo engine runs the full product.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Channel adapters. Defaults let the demo verify webhooks without a Meta app.
WHATSAPP_VERIFY_TOKEN=cedar-verify
MESSENGER_VERIFY_TOKEN=cedar-verify
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_ACCESS_TOKEN=

NEXT_PUBLIC_SUBDOMAIN=clinic-chat
NEXT_PUBLIC_DEMO_URL=https://clinic-chat.quvantic.com
